{
  "io": {
    "image_path": "/path/to/your/images.json",
    "output": "output/qa_output.jsonl",
    "tree_output": "output/qa_tree_state.jsonl",
    "load_tree": null
  },
  "run": {
    "qa_mode": "qa",
    "random_seed": 42,
    "top_k_paths": 10
  },
  "client": {
    "provider": "gemini",
    "max_concurrency": 50,
    "gemini": {
      "model": "gemini-2.5-pro",
      "project_id": null,
      "location": "us-central1",
      "service_account_file": null
    },
    "openai": {
      "api_key": null,
      "base_url": null,
      "model": "gpt-4o"
    },
    "generator_temperature_base": 0.8,
    "generator_temperature_retry_increment": 0.1,
    "generator_temperature_max": 1.2,
    "evaluator_temperature": 0.2,
    "fallback_quality_score": 0.5,
    "backoff_base_delay": 0.5,
    "backoff_max_delay": 5.0,
    "max_retries": 3
  },
  "parallel": {
    "images": 10,
    "nodes": 5,
    "batchs": 5,
    "enable_caching": true,
    "max_attempts_factor": 3
  },
  "mcts": {
    "max_iterations": 5,
    "max_depth": 3,
    "exploration_constant": 2.0,
    "prune_interval": 1000
  },
  "tree": {
    "max_children": {
      "1": 2,
      "2": 1
    },
    "max_total_nodes": 45,
    "levels": {
      "1": {
        "max_nodes": 8,
        "target_nodes": 5
      },
      "2": {
        "max_nodes": 12,
        "target_nodes": 10
      },
      "3": {
        "max_nodes": 15,
        "target_nodes": 10
      }
    },
    "quality": {
      "thresholds": {
        "high": 0.85,
        "medium": 0.6
      },
      "quality_multipliers": {
        "high": 1.3,
        "medium": 1.0,
        "low": 0.7
      },
      "acceptance_threshold": 0.65
    },
    "diversity": {
      "max_similarity": 0.75,
      "recent_check_count": 5,
      "full_scan": true
    },
    "dynamic": {
      "enabled": true,
      "weights": {
        "quality": 0.5,
        "balance": 0.3,
        "success": 0.2
      },
      "adjustment_range": [
        0.8,
        1.6
      ]
    },
    "pruning": {
      "min_visits": 1,
      "min_reward": 0.0
    },
    "duplicate": {
      "enabled": true,
      "question_similarity_threshold": 0.85,
      "answer_similarity_threshold": 0.85
    }
  },
  "logging": {
    "log_level": "DEBUG",
    "log_file": null
  }
}